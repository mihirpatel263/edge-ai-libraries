# Intelligent Multimodal Medical Diagnostic System — Environment Configuration
# Copy this file to .env and customise as needed.

# ─── Application ──────────────────────────────────────────────────────────────
APP_PORT=8200
IMAGE_NAME=meddiag-system:latest

# ─── Demo / AI Mode ───────────────────────────────────────────────────────────
# Set to "false" to require real models
DEMO_MODE=true

# ─── LLM Report Generation (optional) ────────────────────────────────────────
# Uncomment and set to enable LLM-based report generation.
# Compatible with any OpenAI-API-compatible endpoint (vLLM, Ollama, Azure OpenAI, etc.)
# LLM_ENDPOINT_URL=http://your-llm-server:8000
# LLM_MODEL=Llama-3.2-11B-Vision-Instruct
# LLM_MAX_TOKENS=1024

# ─── OpenVINO Model Paths (optional) ─────────────────────────────────────────
# Point to your OpenVINO IR model XML files for real AI inference.
# OPENVINO_CHEST_XRAY_MODEL=/models/chest_xray/model.xml
# OPENVINO_CT_MODEL=/models/ct_scan/model.xml
# OPENVINO_MRI_MODEL=/models/mri/model.xml

# ─── Proxy (if behind corporate firewall) ────────────────────────────────────
# http_proxy=
# https_proxy=
# no_proxy=localhost,127.0.0.1
